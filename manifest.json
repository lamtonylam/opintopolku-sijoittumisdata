{
  "manifest_version": 3,
  "name": "Sijoittumisdata Opintopolussa",
  "short_name": "Sijoittumisdata",
  "version": "0.1.0",
  "description": "Näyttää työttömyysasteen ja mediaanitulon Opintopolun koulutus- ja toteutussivuilla. Perustuu Tilastokeskuksen sijoittumispalvelun aineistoon (valmistuneet 2023, tulot 2024).",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["https://opintopolku.fi/konfo/*"],
      "js": ["match.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Sijoittumisdata Opintopolussa"
  },
  "web_accessible_resources": [
    {
      "resources": ["data/degrees.json", "data/ai-mappings.json"],
      "matches": ["https://opintopolku.fi/*"]
    }
  ]
}
